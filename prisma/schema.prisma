generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  FINANCE
  DESIGNER
  ARTIST_3D
  SUPPORT
  PRODUCT_MANAGER
  CONTENT_MANAGER
}

enum ProductCategory {
  KODENAME_BASE
  ACC
  ADDONS
  OTHER_DIGITAL_PRODUCTS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  SOLD_OUT
}

enum ServicePriceType {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
  CONTACT
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RequestStatus {
  SUBMITTED
  REVIEWING
  QUOTATION
  WAITING_PAYMENT
  PAID
  IN_PROGRESS
  REVISION
  FINAL_REVIEW
  COMPLETED
  CANCELLED
  REJECTED
  ON_HOLD
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  username        String          @unique
  passwordHash    String
  role            UserRole        @default(CUSTOMER)
  emailVerifiedAt DateTime?
  locale          String          @default("id")
  theme           String          @default("system")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        UserSession[]
  orders          Order[]
  requests        ServiceRequest[]
  quotations      Quotation[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  tickets         Ticket[]
  ticketMessages  TicketMessage[]
  notifications   Notification[]
  blogPosts       BlogPost[]
  auditLogs       AuditLog[]
  downloads       DownloadLog[]
  oauthAccounts   OAuthAccount[]

  @@index([role, createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Product {
  id             String           @id @default(cuid())
  sku            String?          @unique
  slug           String           @unique
  name           String
  category       ProductCategory
  description    String           @db.Text
  price          Decimal          @db.Decimal(12, 2)
  compareAtPrice Decimal?         @db.Decimal(12, 2)
  currency       String           @default("IDR")
  status         ProductStatus    @default(DRAFT)
  version        String?
  changelog      String?          @db.Text
  license        String?          @db.Text
  compatibility  Json?
  requirements   Json?
  author         String?
  salesCount     Int              @default(0)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  images         ProductImage[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  bundleItems    BundleItem[]
  downloadLogs   DownloadLog[]

  @@index([category, status, publishedAt])
  @@index([status, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Service {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  category        String
  description     String           @db.Text
  priceType       ServicePriceType @default(CUSTOM_QUOTE)
  price           Decimal?         @db.Decimal(12, 2)
  startingPrice   Decimal?         @db.Decimal(12, 2)
  currency        String           @default("IDR")
  estimatedDays   Int?
  terms           String?          @db.Text
  thumbnailUrl    String?
  status          ServiceStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  requests        ServiceRequest[]

  @@index([status, category])
}

model ServiceRequest {
  id              String        @id @default(cuid())
  requestCode     String        @unique
  customerId      String
  serviceId       String?
  title           String
  description     String        @db.Text
  dimensions      String?
  fileFormat      String?
  deadline        DateTime?
  budget          Decimal?      @db.Decimal(12, 2)
  currency        String        @default("IDR")
  attachments     Json?
  notes           String?       @db.Text
  status          RequestStatus @default(SUBMITTED)
  revisionLimit   Int           @default(2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  quotations      Quotation[]
  revisions       Revision[]

  @@index([customerId, status, createdAt])
  @@index([status, updatedAt])
}

model Quotation {
  id          String          @id @default(cuid())
  requestId   String
  customerId  String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("IDR")
  description String          @db.Text
  revisionLimit Int           @default(2)
  expiresAt   DateTime
  status      QuotationStatus @default(DRAFT)
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  request     ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer    User            @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, status, expiresAt])
  @@index([requestId, createdAt])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("IDR")
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  expiresAt     DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  paymentEvents PaymentEvent[]
  downloads     DownloadLog[]

  @@index([customerId, createdAt])
  @@index([status, paymentStatus, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  productName   String
  unitPrice     Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)
  lineTotal     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model PaymentEvent {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  transactionId     String?
  orderId           String?
  eventType         String
  signatureVerified Boolean @default(false)
  payload           Json
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([orderId, createdAt])
  @@index([transactionId])
}

model DownloadLog {
  id            String   @id @default(cuid())
  orderId       String
  userId        String
  productId     String
  tokenHash     String   @unique
  expiresAt     DateTime
  maxDownloads  Int?
  downloadCount Int      @default(0)
  lastDownloadedAt DateTime?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([orderId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String       @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
}

model Revision {
  id          String         @id @default(cuid())
  requestId   String
  authorId    String?
  note        String         @db.Text
  attachments Json?
  createdAt   DateTime       @default(now())
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Ticket {
  id        String       @id @default(cuid())
  ticketCode String      @unique
  customerId String
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  customer  User         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  messages  TicketMessage[]

  @@index([customerId, status, createdAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String   @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model PortfolioEntry {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  description    String           @db.Text
  category       String
  coverImageUrl  String?
  serviceLabels  String[]
  year           Int?
  featured       Boolean          @default(false)
  status         ContentStatus    @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  caseStudy      ProjectCaseStudy?

  @@index([status, featured, publishedAt])
}

model ProjectCaseStudy {
  id               String         @id @default(cuid())
  portfolioEntryId String         @unique
  content          String         @db.Text
  software         String[]
  completedAt      DateTime?
  portfolioEntry   PortfolioEntry @relation(fields: [portfolioEntryId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String        @id @default(cuid())
  authorId    String
  slug        String        @unique
  title       String
  excerpt     String        @db.Text
  content     String        @db.Text
  coverImageUrl String?
  tags        String[]
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  author      User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  value         Decimal      @db.Decimal(12, 2)
  minimumAmount Decimal?     @db.Decimal(12, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, startsAt, endsAt])
}

model Bundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String       @db.Text
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("IDR")
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       BundleItem[]
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bundleId, productId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
}


model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}
